    <string name="more_clear_title">Delete all data?</string>
    <string name="more_clear_body">All entries, settings, and PDF reports will be deleted. A restore point is saved first: you can bring the data back in “More → Data”. Anything you add after deleting stays when you restore.</string>
    <string name="more_clear_done">All data deleted. You can restore it in “Data”.</string>

    <string name="more_restore_title">Restore data?</string>
    <string name="more_restore_body">Entries from the restore point will come back. Anything added after deleting stays. The restore point is removed afterwards.</string>
    <string name="more_restore_action">Restore</string>
    <string name="more_restore_done">Data restored</string>

    <string name="more_discard_title">Delete restore point?</string>
    <string name="more_discard_body">The snapshot of deleted data will be erased from the device. Those entries cannot be brought back.</string>
    <string name="more_discard_done">Restore point deleted</string>

    <string name="more_lock_disable_title">Turn off app lock?</string>
    <string name="more_lock_disable_body">Anchor will open without confirming your identity. Entries stay on this device only. You can turn protection back on here.</string>
    <string name="more_lock_disable_action">Turn off</string>
