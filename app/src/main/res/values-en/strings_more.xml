    <string name="about_title">About Anchor</string>
    <string name="about_intro">A quiet place to observe yourself. No account, no ads, no mandatory cloud.</string>
    <string name="about_version">Version %1$s · build %2$d</string>
    <string name="about_section_privacy">Privacy</string>
    <string name="about_privacy_accounts_title">No accounts, no analytics</string>
    <string name="about_privacy_accounts_body">No sign-up or automatic data collection by the developer. Bug reports are sent only at your request.</string>
    <string name="about_privacy_local_title">Data on your device</string>
    <string name="about_privacy_local_body">Mood, medications, and journal live in a local database, not encrypted by the app. App lock protects access through the interface.</string>
    <string name="about_privacy_server_title">Your own server, optional</string>
    <string name="about_privacy_server_body">WebDAV sync uses your own folder. Files are encrypted before they are sent.</string>
    <string name="about_section_important">Good to know</string>
    <string name="about_disclaimer_title">This app is not a medical device.</string>
    <string name="about_disclaimer_body">Anchor is a self-observation tool. It does not diagnose, prescribe, or replace a doctor’s advice. Do not change your medication schedule on your own. If your condition worsens, contact a professional.</string>
    <string name="about_footer">Made with respect for people in treatment.</string>
    <string name="about_credits">Open source components: Kotlin, Jetpack Compose, Material 3, Room, WorkManager, OkHttp.</string>
</resources>
