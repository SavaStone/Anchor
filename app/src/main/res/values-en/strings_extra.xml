    <string name="onboarding_accept_required">Please confirm that you understand what this app is for</string>
    <string name="onboarding_permission_hint">When you tap “Get started”, the system may ask for notification permission — it is used only for medication and appointment reminders.</string>
    <string name="onboarding_welcome_title">Welcome to %1$s</string>
    <string name="onboarding_welcome_body">A calm place to note how you feel, keep track of medication, and write down your thoughts. No pressure, no judgement.</string>
    <string name="onboarding_features_title">Everything important, right here</string>
    <string name="onboarding_features_body">Three tools that work together and stay private.</string>
    <string name="onboarding_feature_mood_title">Mood</string>
    <string name="onboarding_feature_mood_body">Calendar, charts, anxiety, energy, sleep, and frequent emotions. See what changes over time.</string>
    <string name="onboarding_feature_meds_title">Medications</string>
    <string name="onboarding_feature_meds_body">Schedules with exact times, notifications with actions, medication supply, and dose history.</string>
    <string name="onboarding_feature_journal_title">Journal</string>
    <string name="onboarding_feature_journal_body">Free-form entries with tags and a mood link. Everything stays on your device.</string>
    <string name="onboarding_feature_privacy_title">Privacy</string>
    <string name="onboarding_feature_privacy_body">No cloud by default. Backups are encrypted, and syncing works only with your own server.</string>
    <string name="onboarding_privacy_title">Just for you</string>
    <string name="onboarding_privacy_body">No sign-up and no data sent anywhere. The app works offline; you can connect your own WebDAV folder if you want.</string>
    <string name="onboarding_name_label">What should we call you?</string>
    <string name="onboarding_name_placeholder">Optional</string>
    <string name="onboarding_consent_title">I understand that %1$s is a self-observation tool, not a medical device</string>
    <string name="onboarding_consent_body">It does not replace a doctor, diagnosis, or treatment. In an emergency, call your local emergency number.</string>
    <string name="onboarding_export_note">You can export your data to an encrypted file at any time.</string>

